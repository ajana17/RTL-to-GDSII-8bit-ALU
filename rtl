module calculator (
    input  [7:0] A,
    input  [7:0] B,
    input  [2:0] sel,

    output reg [7:0] result,
    output reg carry,
    output reg overflow,
    output reg zero
);

reg [8:0] temp;
reg sub;

always @(*) begin

    result = 8'b0;
    carry = 1'b0;
    overflow = 1'b0;
    zero = 1'b0;
    temp = 9'b0;
    sub = 1'b0;

    case (sel)

        3'b000: sub = 1'b0; // ADD
        3'b001: sub = 1'b1; // SUB

        default: sub = 1'b0;

    endcase

    if (sel == 3'b000 || sel == 3'b001) begin

        temp = {1'b0, A} +
               {1'b0, (B ^ {8{sub}})} +
               sub;

        result = temp[7:0];
        carry = temp[8];

        if (sub == 1'b0)
            overflow = (~(A[7] ^ B[7])) &
                       (result[7] ^ A[7]);
        else
            overflow = (A[7] ^ B[7]) &
                       (result[7] ^ A[7]);

    end
    else begin

        case (sel)

            3'b010: result = A & B;
            3'b011: result = A | B;
            3'b100: result = A ^ B;
            3'b101: result = ~A;
            3'b110: result = A << 1;
            3'b111: result = A >> 1;

            default: result = 8'b0;

        endcase

    end

    zero = (result == 8'b0);

end

endmodule
